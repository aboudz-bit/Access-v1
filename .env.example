# ---------------------------------------------------------------------------
# Access — local development environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:
#   Copy-Item .env.example .env
#
# `.env` is git-ignored and is loaded by the local dev helper scripts
# (dev-api.ps1 / dev-web.ps1). On Replit these values are provided by the
# platform instead, so this file is for local (off-Replit) development only.
# ---------------------------------------------------------------------------

# Postgres connection string used by the API server, the DB package, and the
# seed script. Must point at a running Postgres instance.
# Matches the Docker container in the setup docs (host port 5433 to avoid
# colliding with any Postgres already on the default 5432):
#   docker run -d --name access-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=access -p 5433:5432 postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/access

# Secret used to sign the auth cookie token (HMAC-SHA256).
# Any non-empty string works for local dev. REQUIRED in production.
SESSION_SECRET=local-dev-secret-change-me

# Node environment. Keep "development" locally for pretty logs and dev plugins.
NODE_ENV=development

# Optional: pino log level (trace|debug|info|warn|error). Defaults to "info".
# LOG_LEVEL=debug

# Allowed browser origins for CORS (comma-separated). Defaults to the local
# Vite dev origin below. In production set this to your deployed frontend
# origin(s), e.g. https://access.example.com
CORS_ALLOWED_ORIGINS=http://localhost:24510

# Session sweeper (safety net that ends abandoned active sessions and frees the
# interpreter). Milliseconds. Defaults shown.
# SESSION_SWEEP_INTERVAL_MS=30000    # how often the sweeper runs
# SESSION_ABANDON_TIMEOUT_MS=120000  # age before an active+roomless session ends

# ---------------------------------------------------------------------------
# Per-service ports (set by the dev helper scripts; listed here for reference).
# These are NOT read from this file because the two services need different
# values for PORT — the helper scripts export them explicitly.
#
#   API server : PORT=8080
#   Frontend   : PORT=24510  BASE_PATH=/
#
# Optional: override where the Vite dev proxy forwards /api (defaults to
# http://localhost:8080). Use if you run the API server on another port.
# API_PROXY_TARGET=http://localhost:8080
# ---------------------------------------------------------------------------
